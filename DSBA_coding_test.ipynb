   "source": [
    "# qwen2.5-0.5B QLoRA\n",
    "d_05_qlora = train_model('Qwen/Qwen2.5-0.5B', 'qwen2.5-0.5b-qlora', use_lora=True,  max_steps=1200)\n",
    "print(d_05_qlora)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3941e20f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# qwen2.5-1.5B QLoRA\n",
    "d_15_qlora = train_model('Qwen/Qwen2.5-1.5B', 'qwen2.5-1.5b', use_lora=True,  max_steps=600)\n",
    "print(d_15_qlora)"
   ]
  },
  {
   "cell_type": "markdown",
