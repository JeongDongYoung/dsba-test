   "metadata": {},
   "outputs": [],
   "source": [
    "%cd /content\n",
    "!git clone --depth 1 https://github.com/EleutherAI/lm-evaluation-harness\n",
    "!pip install -q -e /content/lm-evaluation-harness\n",
    "!mkdir -p /content/custom_tasks/mathqa_allenai"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile /content/custom_tasks/mathqa_allenai/utils.py\n",
    "import re\n",
    "\n",
    "def doc_to_choice(doc):\n",
    "    return [c[4:].rstrip(\" ,\")\n",
    "            for c in re.findall(r\"[abcd] \\) .*?, |e \\) .*?$\", doc[\"options\"])]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile /content/custom_tasks/mathqa_allenai/mathqa_allenai.yaml\n",
    "task: mathqa\n",
    "dataset_path: allenai/math_qa\n",
    "dataset_kwargs:\n",
    "  trust_remote_code: true\n",
    "output_type: multiple_choice\n",
    "training_split: train\n",
    "validation_split: validation\n",
    "test_split: test\n",
    "doc_to_text: \"Question: {{Problem}}\\nAnswer:\"\n",
    "doc_to_target: \"{{['a', 'b', 'c', 'd', 'e'].index(correct)}}\"\n",
    "doc_to_choice: !function utils.doc_to_choice\n",
    "metric_list:\n",
    "  - metric: acc\n",
    "    aggregation: mean\n",
    "    higher_is_better: true\n",
    "  - metric: acc_norm\n",
    "    aggregation: mean\n",
    "    higher_is_better: true\n",
    "metadata:\n",
    "  version: 1.0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, importlib\n",
    "sys.path.insert(0, \"/content/lm-evaluation-harness\"); importlib.invalidate_caches()\n",
    "import lm_eval, lm_eval.tasks as T\n",
    "from lm_eval.models.huggingface import HFLM\n",
    "TM = T.TaskManager(include_path=\"/content/custom_tasks\")\n",
    "\n",
    "def evaluate_model(path, label):\n",
    "    m = AutoModelForCausalLM.from_pretrained(path, torch_dtype=torch.float16).to('cuda')\n",
    "    tk = AutoTokenizer.from_pretrained(path)\n",
    "    lm = HFLM(pretrained=m, tokenizer=tk, batch_size='auto', trust_remote_code=True)\n",
    "    res = lm_eval.simple_evaluate(model=lm, tasks=['mathqa'], task_manager=TM, limit=None)\n",
    "    r = res['results']['mathqa']\n",
    "    del m, lm; torch.cuda.empty_cache()\n",
    "    return {'label': label, 'model': path, 'acc': r['acc,none'], 'acc_norm': r['acc_norm,none']}\n",
    "\n",
    "eval_results = [\n",
    "    evaluate_model(d_05_ft,    'qwen2.5-0.5b-sft (Full FT)'),\n",
    "    evaluate_model(d_05_qlora, 'qwen2.5-0.5b-sft (QLoRA)'),\n",
    "    evaluate_model(d_15_qlora, 'qwen2.5-1.5b-sft (QLoRA)'),\n",
    "    evaluate_model('Qwen/Qwen2.5-0.5B-Instruct', 'qwen2.5-0.5b-instruct (baseline)'),\n",
    "    evaluate_model('Qwen/Qwen2.5-1.5B-Instruct', 'qwen2.5-1.5b-instruct (baseline)'),\n",
    "]"
   ]
  },
