   "metadata": {},
   "source": [
    "# Qwen2.5 Math Reasoning SFT"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Environment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q \"transformers>=4.46.1\" \"datasets==2.19.2\" \"accelerate>=0.34.0\" \"peft>=0.13.0\" \"bitsandbytes>=0.43.1\" \"wandb\" \"sentencepiece\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, re, json, random\n",
    "import torch\n",
    "from datasets import load_dataset\n",
    "from transformers import (AutoModelForCausalLM, AutoTokenizer, TrainingArguments,Trainer, DataCollatorForSeq2Seq, BitsAndBytesConfig)\n",
    "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training, PeftModel"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "82f48160",
   "metadata": {},
   "source": [
    "Drive Mount"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f8fd6ccf",
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "PROJECT_DIR = \"/content/drive/MyDrive/dsba-coding-test\"\n",
    "CKPT_DIR = f\"{PROJECT_DIR}/checkpoints\"; RESULTS_DIR = f\"{PROJECT_DIR}/results\"\n",
    "os.makedirs(CKPT_DIR, exist_ok=True); os.makedirs(RESULTS_DIR, exist_ok=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "689bf469",
   "metadata": {},
   "source": [
    "WandB Load"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ecd76f41",
   "metadata": {},
   "outputs": [],
   "source": [
    "import wandb\n",
    "wandb.login()\n",
    "os.environ[\"WANDB_PROJECT\"] = \"dsba-coding-test-math-sft\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Dataset Load"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "train 8492 / val 300\n",
      "{'prompt': 'Question: John books 3 nights at a hotel room for $250 a night.  He has a $100 discount.  How much does he pay?\\nGive me a solution to this problem\\nAnswer:', 'response': ' 650. The cost is 250*3=$750\\nSo he spends 750-100=$650'}\n"
     ]
    }
   ],
   "source": [
    "SEED = 42\n",
    "random.seed(SEED)\n",
    "MAX_SEQ_LEN = 512\n",
    "N_VAL = 300\n",
    "\n",
    "PROMPT_TEMPLATE = \"Question: {instruction}\\nAnswer:\"\n",
    "\n",
    "def extract_final_answer(txt):\n",
    "    txt = txt.strip()\n",
    "    sents = [x.strip() for x in re.split(r\"(?<=[.!?])\\s+\", txt) if x.strip()]\n",
    "    cand = sents[-1] if sents else txt\n",
    "    nums = re.findall(r\"-?\\d[\\d,]*\\.?\\d*\", cand) or re.findall(r\"-?\\d[\\d,]*\\.?\\d*\", txt)\n",
    "    return nums[-1].replace(\",\", \"\") if nums else None\n",
    "\n",
    "def build(ex):\n",
    "    prompt = PROMPT_TEMPLATE.format(instruction=ex[\"INSTRUCTION\"].strip())\n",
    "    full = ex[\"RESPONSE\"].strip()\n",
    "    ans = extract_final_answer(full)\n",
    "    resp = f\"{ans}. {full[:400]}\" if ans is not None else full[:420]\n",
    "    return {\"prompt\": prompt, \"response\": \" \" + resp}\n",
    "\n",
    "raw = load_dataset(\"qwedsacf/grade-school-math-instructions\", split=\"train\")\n",
    "proc = raw.shuffle(seed=SEED).map(build, remove_columns=raw.column_names)\n",
    "val_raw = proc.select(range(N_VAL)); train_raw = proc.select(range(N_VAL, len(proc)))\n",
    "print(f\"train {len(train_raw)} / val {len(val_raw)}\")\n",
    "print(train_raw[0])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Train Setting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Training settings\n",
    "PER_DEVICE_BATCH = 4\n",
    "GRAD_ACCUM = 4\n",
    "LR_FULL_FT = 2e-5\n",
    "LR_LORA = 2e-4\n",
    "\n",
    "LORA_CONFIG = LoraConfig(\n",
    "    r=16, lora_alpha=32, lora_dropout=0.05, bias='none', task_type='CAUSAL_LM',\n",
    "    target_modules=['q_proj','k_proj','v_proj','o_proj','gate_proj','up_proj','down_proj'])\n",
    "\n",
    "BNB_CONFIG = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type='nf4',\n",
    "    bnb_4bit_compute_dtype=torch.float16, bnb_4bit_use_double_quant=True)\n",
    "\n",
    "def make_tokenize_fn(tok):\n",
    "    def fn(ex):\n",
    "        p = tok(ex[\"prompt\"], add_special_tokens=False)[\"input_ids\"]\n",
    "        r = tok(ex[\"response\"] + tok.eos_token, add_special_tokens=False)[\"input_ids\"]\n",
    "        ids = (p + r)[:MAX_SEQ_LEN]\n",
    "        labels = ([-100]*len(p) + r)[:MAX_SEQ_LEN]\n",
    "        return {\"input_ids\": ids, \"labels\": labels, \"attention_mask\": [1]*len(ids)}\n",
    "    return fn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train model\n",
    "def train_model(model_id, output_name, use_lora, max_steps):\n",
    "    tok = AutoTokenizer.from_pretrained(model_id)\n",
    "    if tok.pad_token is None: tok.pad_token = tok.eos_token\n",
    "    tfn = make_tokenize_fn(tok)\n",
    "    train_tok = train_raw.map(tfn, remove_columns=train_raw.column_names)\n",
    "    val_tok = val_raw.map(tfn, remove_columns=val_raw.column_names)\n",
    "\n",
    "    out_dir = f'{CKPT_DIR}/{output_name}'\n",
    "    if use_lora:\n",
    "        model = AutoModelForCausalLM.from_pretrained(model_id, quantization_config=BNB_CONFIG, device_map={'':0})\n",
    "        model = prepare_model_for_kbit_training(model)\n",
    "        model = get_peft_model(model, LORA_CONFIG)\n",
    "        lr = LR_LORA\n",
    "    else:\n",
    "        model = AutoModelForCausalLM.from_pretrained(model_id, dtype=torch.float32, device_map={'':0})\n",
    "        lr = LR_FULL_FT\n",
    "    model.gradient_checkpointing_enable(); model.config.use_cache = False\n",
    "\n",
    "    args = TrainingArguments(\n",
    "        output_dir=out_dir, \n",
    "        per_device_train_batch_size=PER_DEVICE_BATCH,\n",
    "        per_device_eval_batch_size=PER_DEVICE_BATCH, \n",
    "        gradient_accumulation_steps=GRAD_ACCUM,\n",
    "        max_steps=max_steps, \n",
    "        num_train_epochs=3, \n",
    "        learning_rate=lr,\n",
    "        lr_scheduler_type='cosine', \n",
    "        warmup_ratio=0.03, \n",
    "        optim='adamw_bnb_8bit',\n",
    "        logging_steps=25, \n",
    "        eval_strategy='steps', \n",
    "        eval_steps=50,\n",
    "        save_strategy='steps', \n",
    "        save_steps=100, \n",
    "        save_total_limit=2,\n",
    "        load_best_model_at_end=True, \n",
    "        metric_for_best_model='eval_loss', \n",
    "        greater_is_better=False,\n",
    "        fp16=True, \n",
    "        report_to='wandb', \n",
    "        run_name=f'{output_name}-sft')\n",
    "    collator = DataCollatorForSeq2Seq(tokenizer=tok, model=None, padding=True, label_pad_token_id=-100)\n",
    "    trainer = Trainer(model=model, args=args, train_dataset=train_tok, eval_dataset=val_tok, data_collator=collator)\n",
    "    trainer.train()\n",
    "\n",
    "    if use_lora:\n",
    "        trainer.save_model(out_dir); tok.save_pretrained(out_dir)\n",
    "        del trainer, model; torch.cuda.empty_cache()\n",
    "        base = AutoModelForCausalLM.from_pretrained(model_id, torch_dtype=torch.float16, device_map={'':0})\n",
    "        merged = PeftModel.from_pretrained(base, out_dir).merge_and_unload()\n",
    "        merged_dir = f'{out_dir}_merged'; merged.save_pretrained(merged_dir); tok.save_pretrained(merged_dir)\n",
    "        del base, merged; torch.cuda.empty_cache()\n",
    "        return merged_dir\n",
    "    else:\n",
    "        trainer.save_model(out_dir); tok.save_pretrained(out_dir)\n",
    "        del trainer, model; torch.cuda.empty_cache()\n",
    "        return out_dir"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Train"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# qwen2.5-0.5B Full FT\n",
    "d_05_ft = train_model('Qwen/Qwen2.5-0.5B', 'qwen2.5-0.5b', use_lora=False, max_steps=1200)\n",
    "print(d_05_ft)"
   ]
  },
  {
